local antiLagOriginals = {}
local originalQualityLevel
local antiLagQualitySaved = false
local function saveAndDisable(instance, propertyName)
    local ok, value = pcall(function()
        return instance[propertyName]
    end)
    if not ok then return end
    if antiLagOriginals[instance] == nil then
        antiLagOriginals[instance] = {}
    end
    if antiLagOriginals[instance][propertyName] == nil then
        antiLagOriginals[instance][propertyName] = value
    end
    pcall(function()
        instance[propertyName] = false
    end)
end
local function applyAntiLag(enabled)
    if enabled then
        for _, instance in ipairs(Lighting:GetDescendants()) do
            if instance:IsA("PostEffect") then
                saveAndDisable(instance, "Enabled")
            end
        end
        for _, instance in ipairs(Workspace:GetDescendants()) do
            if instance:IsA("ParticleEmitter")
                or instance:IsA("Trail")
                or instance:IsA("Beam")
                or instance:IsA("Fire")
                or instance:IsA("Smoke")
                or instance:IsA("Sparkles") then
                saveAndDisable(instance, "Enabled")
            end
        end
        if not antiLagQualitySaved then
            local ok, quality = pcall(function()
                return settings().Rendering.QualityLevel
            end)
            if ok then
                originalQualityLevel = quality
                antiLagQualitySaved = true
            end
        end
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
    else
        for instance, properties in pairs(antiLagOriginals) do
            if instance and instance.Parent then
                for propertyName, originalValue in pairs(properties) do
                    pcall(function()
                        instance[propertyName] = originalValue
                    end)
                end
            end
        end
        table.clear(antiLagOriginals)
        if antiLagQualitySaved then
            pcall(function()
                settings().Rendering.QualityLevel = originalQualityLevel
            end)
        end
        originalQualityLevel = nil
        antiLagQualitySaved = false
    end
end
