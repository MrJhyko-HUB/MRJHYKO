local function closeHub()
    isFarming = false
    autoStrength = false
    if strengthConnection then
        strengthConnection:Disconnect()
        strengthConnection = nil
    end
    if strengthCharacterConnection then
        strengthCharacterConnection:Disconnect()
        strengthCharacterConnection = nil
    end
    if isAntiLag then
        applyAntiLag(false)
    end
    isAntiLag = false
    showFPS = false
    antiIdle = false
    showCoords = false
    if coordsConnection then
        coordsConnection:Disconnect()
        coordsConnection = nil
    end
    if fpsConnection then
        fpsConnection:Disconnect()
        fpsConnection = nil
    end
    if idleConnection then
        idleConnection:Disconnect()
        idleConnection = nil
    end
    for _, conn in ipairs(connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:UnequipTools()
            end
        end
    end)
    -- Animación de cierre antes de eliminar la interfaz
    if MainFrame and MainFrame.Parent then
        local closeTween = TweenService:Create(MainFrame,
            TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
            {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1})
        closeTween:Play()
        closeTween.Completed:Once(function()
            if ScreenGui and ScreenGui.Parent then ScreenGui:Destroy() end
        end)
    else
        ScreenGui:Destroy()
    end
end
