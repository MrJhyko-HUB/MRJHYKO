local function createPortalButton(label, order, x, y, z)
    local button = Instance.new("TextButton")
    button.Name = "Portal_" .. tostring(order)
    button.Parent = PortalList
    button.LayoutOrder = order
    button.Size = UDim2.new(1, -5, 0, 43)
    button.BackgroundColor3 = CARD
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Text = "  " .. label
    button.Font = Enum.Font.SourceSansSemibold
    button.TextSize = 17
    button.TextColor3 = WHITE
    button.TextXAlignment = Enum.TextXAlignment.Left
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = button
    local stroke = Instance.new("UIStroke")
    stroke.Color = PINK_DARK
    stroke.Transparency = 0.45
    stroke.Parent = button
    button.MouseEnter:Connect(function()
        if button.Parent then
            TweenService:Create(button, TweenInfo.new(0.16), {
                BackgroundColor3 = Color3.fromRGB(75, 30, 69)
            }):Play()
        end
    end)
    button.MouseLeave:Connect(function()
        if button.Parent then
            TweenService:Create(button, TweenInfo.new(0.16), {
                BackgroundColor3 = CARD
            }):Play()
        end
    end)
    button.MouseButton1Click:Connect(function()
        local character = LocalPlayer.Character
        local root = character
            and character:FindFirstChild("HumanoidRootPart")
        if not root then
            warn("Jhyko Hub: el personaje no está disponible para teletransportarse.")
            return
        end
        root.CFrame = CFrame.new(x, y, z)
        print("Jhyko Hub: teletransporte a " .. label)
    end)
end
