-- Mantener Weight equipado mientras la opción esté activa
local function equipWeight()
    if not autoStrength then return end
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not character or not backpack then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    local weight = character:FindFirstChild("Weight")
        or backpack:FindFirstChild("Weight")
    if weight and weight:IsA("Tool") and weight.Parent ~= character then
        pcall(function()
            humanoid:EquipTool(weight)
        end)
    end
end
local function startStrengthFarm()
    if strengthConnection then
        strengthConnection:Disconnect()
        strengthConnection = nil
    end
    if strengthCharacterConnection then
        strengthCharacterConnection:Disconnect()
        strengthCharacterConnection = nil
    end
    -- Revisar si Weight sigue equipado
    strengthConnection = RunService.Heartbeat:Connect(function()
        if autoStrength then
            equipWeight()
        end
    end)
    -- Volver a equiparlo después de morir y reaparecer
    strengthCharacterConnection = LocalPlayer.CharacterAdded:Connect(function()
        if not autoStrength then return end
        task.spawn(function()
            local backpack = LocalPlayer:WaitForChild("Backpack", 10)
            if not backpack or not autoStrength then return end
            local character = LocalPlayer.Character
            if not character then
                character = LocalPlayer.CharacterAdded:Wait()
            end
            if not autoStrength then return end
            character:WaitForChild("Humanoid", 10)
            task.wait(0.5)
            if autoStrength then
                equipWeight()
            end
        end)
    end)
    -- Intento inicial
    task.spawn(function()
        for _ = 1, 20 do
            if not autoStrength then return end
            equipWeight()
            local character = LocalPlayer.Character
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            local weight = (character and character:FindFirstChild("Weight"))
                or (backpack and backpack:FindFirstChild("Weight"))
            if weight and character and weight.Parent == character then
                return
            end
            task.wait(0.25)
        end
    end)
end
