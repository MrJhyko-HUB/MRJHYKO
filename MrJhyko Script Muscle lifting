local function startFarming()
    task.spawn(function()
        while isFarming do
            local playerList = Players:GetPlayers()
            local targetFound = false
            for _, targetPlayer in ipairs(playerList) do
                if not isFarming then break end
                if targetPlayer ~= LocalPlayer then
                    local targetChar = targetPlayer.Character
                    local targetHum = targetChar
                        and targetChar:FindFirstChildOfClass("Humanoid")
                    local targetHRP = targetChar
                        and targetChar:FindFirstChild("HumanoidRootPart")
                    if targetHum and targetHum.Health > 0
                        and targetHRP and targetChar.Parent == workspace then
                        targetFound = true
                        local startTime = tick()
                        local maxAttackTime = 4
                        while isFarming
                            and targetHum
                            and targetHum.Health > 0
                            and targetHum:GetState() ~= Enum.HumanoidStateType.Dead
                            and targetChar.Parent == workspace
                            and (tick() - startTime) < maxAttackTime do
                            local char = LocalPlayer.Character
                            local hrp = char
                                and char:FindFirstChild("HumanoidRootPart")
                            local backpack = LocalPlayer:FindFirstChild("Backpack")
                            if char and hrp and backpack then
                                local punch = backpack:FindFirstChild("Punch")
                                    or char:FindFirstChild("Punch")
                                if punch then
                                    local humanoid =
                                        char:FindFirstChildOfClass("Humanoid")
                                    if humanoid and punch.Parent ~= char then
                                        humanoid:EquipTool(punch)
                                    end
                                    hrp.CFrame =
                                        targetHRP.CFrame + Vector3.new(0, 3, 0)
                                    hrp.AssemblyLinearVelocity =
                                        Vector3.new(0, 0, 0)
                                    hrp.AssemblyAngularVelocity =
                                        Vector3.new(0, 0, 0)
                                    pcall(function()
                                        punch:Activate()
                                    end)
                                end
                            end
                            task.wait(0.08)
                        end
                        task.wait(0.1)
                    end
                end
            end
            if not targetFound then
                task.wait(0.5)
            end
        end
    end)
end
