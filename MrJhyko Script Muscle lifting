local function refreshTabs()
    local activeTab =
        (MainPage.Visible and TabMain)
        or (FarmPage.Visible and TabFarm)
        or (PortalsPage.Visible and TabPortals)
        or TabMisc
    for _, tab in ipairs(allTabs) do
        local active = tab == activeTab
        tab.BackgroundColor3 = active
            and Color3.fromRGB(75, 27, 65)
            or CARD
        tab.TextColor3 = active and PINK or MUTED
    end
end
