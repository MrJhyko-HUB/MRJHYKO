local hubMinimized = false
local savedChildVisibility = {}
local fullHubSize = UDim2.new(0, 650, 0, 420)
local minimizedHubSize = UDim2.new(0, 650, 0, 46)
local minimizeTween
local function setMinimized(minimize)
    if not MainFrame or not MainFrame.Parent or hubMinimized == minimize then return end
    hubMinimized = minimize
    if minimizeTween then
        minimizeTween:Cancel()
        minimizeTween = nil
    end
    if minimize then
        -- Guarda el estado, pero no oculta el contenido de golpe:
        -- ClipsDescendants permite que la interfaz se recoja suavemente
        -- hasta convertirse en la barra superior, como en el Scooter Hub.
        table.clear(savedChildVisibility)
        for _, child in ipairs(MainFrame:GetChildren()) do
            if child:IsA("GuiObject") and child ~= TopBar then
                savedChildVisibility[child] = child.Visible
            end
        end
        MinimizeBtn.Text = "+"
        minimizeTween = TweenService:Create(
            MainFrame,
            TweenInfo.new(0.36, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
            {Size = minimizedHubSize, BackgroundTransparency = 0}
        )
        minimizeTween:Play()
        minimizeTween.Completed:Once(function()
            if not MainFrame or not MainFrame.Parent or not hubMinimized then return end
            for child in pairs(savedChildVisibility) do
                if child and child.Parent == MainFrame then
                    child.Visible = false
                end
            end
        end)
    else
        -- Vuelve a mostrar el contenido antes de expandir el panel.
        for child, wasVisible in pairs(savedChildVisibility) do
            if child and child.Parent == MainFrame then
                child.Visible = wasVisible
            end
        end
        MinimizeBtn.Text = "−"
        minimizeTween = TweenService:Create(
            MainFrame,
            TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Size = fullHubSize, BackgroundTransparency = 0}
        )
        minimizeTween:Play()
        minimizeTween.Completed:Once(function()
            if not hubMinimized then table.clear(savedChildVisibility) end
        end)
    end
end
MinimizeBtn.Activated:Connect(function()
