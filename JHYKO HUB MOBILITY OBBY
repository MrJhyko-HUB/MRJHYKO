    end
end

stopFarm = function(message)
    farming = false
    stopMovementConnection()
    setNoClip(false)
    FarmStatus.Text = "Estado: " .. (message or "Detenido")
    FarmStart.Text = "INICIAR"
    FarmStart.BackgroundColor3 = PINK
end

startRebirthLoop = function()
    if not farming then return end
    if not autoRebirth then
        stopFarm("Objetivo alcanzado")
        return
    end
    local map = Workspace:FindFirstChild("Map")
    local rebirthBtn = map and map:FindFirstChild("RebirthButton", true)
    if rebirthBtn and rebirthBtn:IsA("Model") then
        rebirthBtn = rebirthBtn.PrimaryPart or rebirthBtn:FindFirstChildWhichIsA("BasePart", true)
    end
    if not rebirthBtn or not rebirthBtn:IsA("BasePart") then
        stopFarm("Falta RebirthButton")
        return
    end
    stopMovementConnection()
    FarmStatus.Text = "Estado: Yendo al Rebirth..."
    movementConnection = RunService.Heartbeat:Connect(function()
        if not farming then return end
        updateTimer()
        local currentStage = getStage()
        if currentStage and currentStage < farmTargetStage then
            rebirthCount += 1
            stopMovementConnection()
            task.delay(0.5, function()
                if farming then moveToCheckpoint() end
            end)
            return
        end
        local root = getRoot()
        if not root then return end
        local targetPart = getTargetPart(root) or root
        local delta = rebirthBtn.Position - targetPart.Position
        if delta.Magnitude < 5 then
            targetPart.AssemblyLinearVelocity = Vector3.new(0, -2, 0)
            FarmStatus.Text = "Estado: Rebirth en curso..."
            return
        end
        targetPart.AssemblyLinearVelocity = delta.Unit * farmSpeed + Vector3.new(0, 2, 0)
    end)
end

moveToCheckpoint = function()
    if not farming then return end
    local stage = getStage()
    local checkpoints = getCheckpointFolder()
    if stage == nil or not checkpoints then
        stopFarm("Falta Stage o Checkpoints")
        return
    end
    if stage >= farmTargetStage then
        if autoRebirth then startRebirthLoop() else stopFarm("Objetivo alcanzado") end
        return
    end
    local nextStage = math.max(2, stage + 1)
    local function moveNext()
        if not farming then return end
        if nextStage > farmTargetStage then
            if autoRebirth then startRebirthLoop() else stopFarm("Objetivo alcanzado") end
            return
        end
        local checkpoint = checkpoints:FindFirstChild(tostring(nextStage))
        if not checkpoint or not checkpoint:IsA("BasePart") then
            stopFarm("Falta checkpoint " .. nextStage)
            return
        end
        local root = getRoot()
        if not root then
            stopFarm("Personaje no disponible")
            return
        end
        stopMovementConnection()
        FarmStatus.Text = string.format("Estado: Etapa %d/%d", nextStage, farmTargetStage)
        movementConnection = RunService.Heartbeat:Connect(function()
            if not farming then return end
            if not root.Parent then
                stopMovementConnection()
                return
            end
            updateTimer()
            local currentStage = getStage()
            if currentStage and currentStage >= farmTargetStage then
                stopMovementConnection()
                if autoRebirth then startRebirthLoop() else stopFarm("Objetivo alcanzado") end
                return
            end
            local targetPart = getTargetPart(root) or root
            local delta = checkpoint.Position - targetPart.Position
            if delta.Magnitude < 5 then
                targetPart.AssemblyLinearVelocity = Vector3.zero
                stopMovementConnection()
                nextStage += 1
                task.delay(0.15, function()
                    if farming then moveNext() end
                end)
                return
            end
            targetPart.AssemblyLinearVelocity = delta.Unit * farmSpeed + Vector3.new(0, 2, 0)
            FarmStatus.Text = string.format("Estado: Etapa %d/%d",
                currentStage or nextStage, farmTargetStage)
        end)
    end
    moveNext()
end

