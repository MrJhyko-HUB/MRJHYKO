local function getStage()
    local stats = LocalPlayer:FindFirstChild("leaderstats")
    local value = stats and stats:FindFirstChild("Stage")
    return value and tonumber(value.Value)
end

local function updateTimer()
    if not farming then return end
    local elapsed = math.floor(os.clock() - startTime)
    FarmTimer.Text = string.format("Tiempo: %02d:%02d",
        math.floor(elapsed / 60), elapsed % 60)
end

local function getVehicle()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.SeatPart then
        local seat = humanoid.SeatPart
        local model = seat
        while model and model.Parent and model.Parent ~= Workspace do
            model = model.Parent
            if model:IsA("Model") then return model end
        end
        return seat.Parent
    end
    return nil
end

local function setNoClip(enabled)
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    if enabled then
        noclipConnection = RunService.Stepped:Connect(function()
            local function disableCollisions(container)
                if not container then return end
                for _, part in ipairs(container:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if originalCollisions[part] == nil then
                            originalCollisions[part] = part.CanCollide
                        end
                        part.CanCollide = false
                    end
                end
            end
            disableCollisions(LocalPlayer.Character)
            disableCollisions(getVehicle())
        end)
    else
        for part, originalValue in pairs(originalCollisions) do
            if part and part.Parent then
                pcall(function() part.CanCollide = originalValue end)
            end
        end
        table.clear(originalCollisions)
    end
end

local function getRoot()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getTargetPart(root)
    local vehicle = getVehicle()
    if vehicle then
        local part = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart", true)
        if part then return part end
    end
    return root
end

local function getCheckpointFolder()
