local dragging = false
local dragStart, startPosition

addConnection(TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end))

addConnection(UserInputService.InputChanged:Connect(function(input)
    if dragging and dragStart and startPosition and
        (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
    end
end))

local hubVisibilityTween
local hubAnimating = false
local HUB_OPEN_SIZE = UDim2.fromOffset(650, 440)

local HubScale = MainFrame:FindFirstChildOfClass("UIScale")
if not HubScale then
    HubScale = Instance.new("UIScale")
    HubScale.Scale = 1
    HubScale.Parent = MainFrame
end

local function toggleHubAnimated()
    if closed or hubAnimating then return end
    hubAnimating = true
    if hubVisibilityTween then
        hubVisibilityTween:Cancel()
        hubVisibilityTween = nil
    end
    if MainFrame.Visible then
        hubVisibilityTween = TweenService:Create(
            HubScale,
            TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.In),
            {Scale = 0.03}
        )
        hubVisibilityTween:Play()
        hubVisibilityTween.Completed:Once(function()
            MainFrame.Visible = false
            HubScale.Scale = 1
            hubAnimating = false
            hubVisibilityTween = nil
        end)
    else
        HubScale.Scale = 0.03
        MainFrame.Size = HUB_OPEN_SIZE
        MainFrame.BackgroundTransparency = 0
        MainFrame.Visible = true
        hubVisibilityTween = TweenService:Create(
            HubScale,
            TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Scale = 1}
        )
        hubVisibilityTween:Play()
        hubVisibilityTween.Completed:Once(function()
            hubAnimating = false
            hubVisibilityTween = nil
        end)
    end
end

addConnection(UserInputService.InputBegan:Connect(function(input, processed)
    if processed or closed then return end
    if input.KeyCode == Enum.KeyCode.H then
        toggleHubAnimated()
    end
end))

