local function getEggZone12()
    local eggsFolder = Workspace:FindFirstChild("Eggs")
    return eggsFolder and eggsFolder:FindFirstChild("Zone12")
end

local function getEggPart(object)
    if not object then return nil end
    if object:IsA("BasePart") then return object end
    if object:IsA("Model") then
        return object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
    end
    return object:FindFirstChildWhichIsA("BasePart", true)
end

local function getReadyEggs()
    local results = {}
    local zone = getEggZone12()
    if not zone then return results end

    for _, nest in ipairs(zone:GetChildren()) do
        local spawned = nest:FindFirstChild("SpawnedEgg")
        if spawned then
            for _, egg in ipairs(spawned:GetChildren()) do
                local lowerName = string.lower(egg.Name)
                local ignored = string.find(lowerName, "initial") or string.find(lowerName, "anim")
                local part = not ignored and getEggPart(egg) or nil
                if part then
                    local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
                        or nest:FindFirstChildWhichIsA("ProximityPrompt", true)
                    local combinedName = string.lower(egg.Name .. " " .. nest.Name)
                    local giant = string.find(combinedName, "giant") ~= nil
                        or egg:FindFirstChild("GiantGlow", true) ~= nil
                        or nest:FindFirstChild("GiantGlow", true) ~= nil
                    table.insert(results, {
                        Egg = egg,
                        Part = part,
                        Prompt = prompt,
                        Giant = giant,
                    })
                end
            end
        end
    end
    return results
end

local function eggStillExists(info)
    return info and info.Egg and info.Egg.Parent ~= nil
        and info.Part and info.Part.Parent ~= nil
end

local function chooseEgg(eggs)
    for _, info in ipairs(eggs) do
        if info.Giant then return info end
    end
    return eggs[1]
end

local function attemptEggPrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return end
    pcall(function()
        prompt:InputHoldBegin()
        task.wait(math.max(prompt.HoldDuration, 0.1))
        if prompt.Parent then prompt:InputHoldEnd() end
    end)
end

local function isNightTime()
    local clock = Lighting.ClockTime
    return clock <= 5 or clock >= 19
end

local function collectOneEgg()
    local eggs = getReadyEggs()
    while eggAutoEnabled and not closed and #eggs == 0 do
        if isNightTime() then
            EggStatus.Text = "🌙 Es de noche (en el spawn)... Esperando amanecer."
            return
        end
        EggStatus.Text = "Esperando huevos en Zona 12... No me muevo."
        task.wait(EGG_POLL_INTERVAL)
        eggs = getReadyEggs()
    end
    if not eggAutoEnabled or closed or #eggs == 0 then return end

    local chosen = chooseEgg(eggs)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        EggStatus.Text = "Personaje no disponible; esperando..."
        task.wait(1)
        return
    end

    EggStatus.Text = chosen.Giant and "Yendo a Zona 12 (GIANT)..." or "Yendo a Zona 12..."
    character:PivotTo(CFrame.new(EGG_ZONE_COORDS))
    task.wait(0.4)
    if not eggAutoEnabled or closed then return end

    if not eggStillExists(chosen) then
        eggs = getReadyEggs()
        if #eggs == 0 then
            EggStatus.Text = "El huevo ya no está; buscando otro..."
            return
        end
        chosen = chooseEgg(eggs)
    end

    local part = getEggPart(chosen.Egg)
    if not part then return end
    character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    EggStatus.Text = chosen.Giant and "Acercándose al huevo GIANT..." or "Acercándose al huevo..."
    character:PivotTo(CFrame.new(part.Position + Vector3.new(0, 2, 0)))
    task.wait(0.4)
    if not eggAutoEnabled or closed then return end

    if chosen.Prompt and chosen.Prompt.Parent and chosen.Prompt.Enabled then
        attemptEggPrompt(chosen.Prompt)
    end

    EggStatus.Text = "Esperando que el juego recoja el huevo..."
    local startedAt = os.clock()
    local pickupDetected = false
    while os.clock() - startedAt < EGG_PICKUP_TIMEOUT and eggAutoEnabled and not closed do
        if not eggStillExists(chosen)
            or (chosen.Prompt and chosen.Prompt.Parent and not chosen.Prompt.Enabled) then
            pickupDetected = true
            break
        end
        task.wait(0.2)
    end
    if not eggAutoEnabled or closed then return end

    character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        EggStatus.Text = "Personaje no disponible para guardar."
        return
    end

    EggStatus.Text = pickupDetected and "Recogida detectada; subiendo para guardar..."
        or "Sin confirmación visible; intentando guardar..."
    root.CFrame = root.CFrame + Vector3.new(0, EGG_SAVE_HEIGHT, 0)
    task.wait(EGG_SAVE_WAIT)

    EggStatus.Text = pickupDetected and "Ciclo completado; buscando otro huevo..."
        or "Subida hecha; verificando el siguiente huevo..."
end

