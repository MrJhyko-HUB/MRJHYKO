local function saveAndDisable(instance, propertyName)
    local ok, value = pcall(function() return instance[propertyName] end)
    if not ok then return end
    antiLagOriginals[instance] = antiLagOriginals[instance] or {}
    if antiLagOriginals[instance][propertyName] == nil then
        antiLagOriginals[instance][propertyName] = value
    end
    pcall(function() instance[propertyName] = false end)
end

local function applyAntiLag(enabled)
    if enabled then
        for _, obj in ipairs(Lighting:GetDescendants()) do
            if obj:IsA("PostEffect") then saveAndDisable(obj, "Enabled") end
        end
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                saveAndDisable(obj, "Enabled")
            end
        end
        if not qualitySaved then
            local ok, quality = pcall(function() return settings().Rendering.QualityLevel end)
            if ok then originalQualityLevel = quality; qualitySaved = true end
        end
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    else
        for obj, props in pairs(antiLagOriginals) do
            if obj and obj.Parent then
                for prop, value in pairs(props) do
                    pcall(function() obj[prop] = value end)
                end
            end
        end
        table.clear(antiLagOriginals)
        if qualitySaved then
            pcall(function() settings().Rendering.QualityLevel = originalQualityLevel end)
        end
        originalQualityLevel, qualitySaved = nil, false
    end
end

