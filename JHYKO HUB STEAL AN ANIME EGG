local function selectTab(which)
    MainPage.Visible = which == "Main"
    FarmPage.Visible = which == "Farm"
    TeleportPage.Visible = which == "Teleport"
    MiscPage.Visible = which == "Misc"
    for name, button in pairs({Main = TabMain, Farm = TabFarm, Teleport = TabTeleport, Misc = TabMisc}) do
        local active = name == which
        button.TextColor3 = active and PINK or MUTED
        button.BackgroundTransparency = active and 0 or 1
        button.BackgroundColor3 = active and CARD or PANEL
    end
end

